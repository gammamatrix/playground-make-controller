    /**
     * Save a revision of a {{model_label}}.
     */
    public function saveRevision({{ model }} ${{model_variable}}): {{ model }}Revision
    {
        /**
         * @var array<string, mixed> $data
         */
        $data = ${{ model_slug }}->toArray();

        $revision = new {{ model }}Revision($data);

        $revision->created_by_id = ${{model_variable}}->created_by_id;
        $revision->modified_by_id = ${{model_variable}}->modified_by_id;
        $revision->owned_by_id = ${{model_variable}}->owned_by_id;
        $revision->{{model_variable}}_id = ${{model_variable}}->id;

        $r = {{ model }}Revision::where('{{model_variable}}_id', ${{model_variable}}->id)->max('revision');
        $r = ! is_numeric($r) || empty($r) || $r < 0 ? 0 : (int) $r;
        $r++;

        $revision->revision = $r;
        ${{model_variable}}->revision = $r;

        $revision->saveOrFail();

        return $revision;
    }

