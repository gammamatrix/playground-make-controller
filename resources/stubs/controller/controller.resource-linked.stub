    /**
     * Remove the {{model_label}} resource from storage.
     *
     * @route DELETE /resource/{{module_slug}}/{{model_slugs}}/{{{model_route_param}}} {{model_route}}.destroy
     */
    public function destroy(
        {{ model }} ${{model_variable}},
        Requests\{{ model }}\DestroyRequest $request
    ): Response|RedirectResponse {

        $packageInfo = $this->packageInfo();

        $validated = $request->validated();

        $user = $request->user();

        if ($user?->id) {
            ${{model_variable}}->modified_by_id = $user->id;
        }

        if (empty($validated['force'])) {
            ${{model_variable}}->delete();
        } else {
            ${{model_variable}}->forceDelete();
        }

        if ($request->expectsJson()) {
            return response()->noContent();
        }

        $returnUrl = $validated['_return_url'] ?? '';

        if ($returnUrl && is_string($returnUrl)) {
            return redirect($returnUrl);
        }

        return redirect(route($packageInfo->model_route()));
    }

    /**
     * Store a newly created API {{model_label}} resource in storage.
     *
     * @route POST /resource/{{module_slug}}/{{model_slugs}} {{model_route}}.post
     */
    public function store(
        Requests\{{ model }}\StoreRequest $request
    ): Response|JsonResponse|RedirectResponse|Resources\{{ model }} {

        $packageInfo = $this->packageInfo();

        $validated = $request->validated();

        $user = $request->user();

        ${{model_variable}} = new {{ model }}($validated);

        ${{model_variable}}->created_by_id = $user?->id;

        ${{model_variable}}->save();

        if ($request->expectsJson()) {
            return new Resources\{{ model }}(${{model_variable}})->additional(['meta' => [
                'info' => $packageInfo,
            ]])->response($request)->setStatusCode(201);
        }

        $returnUrl = $validated['_return_url'] ?? '';

        if ($returnUrl && is_string($returnUrl)) {
            return redirect($returnUrl);
        }

        return redirect(route(sprintf(
            '%1$s.show',
            $packageInfo->model_route()
        ), ['{{model_route_param}}' => ${{model_variable}}->id]));
    }

