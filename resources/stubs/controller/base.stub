<?php

/**
 * {{organization}}
 */

declare(strict_types=1);

namespace {{ namespace }}\Http\Controllers;

{{ use }}use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
// use Illuminate\Foundation\Bus\DispatchesJobs;
use Illuminate\Foundation\Validation\ValidatesRequests;
use Illuminate\Routing\Controller as BaseController;
use Playground\PackageInfo;

/**
 * \{{ namespace }}\Http\Controllers\Controller
 */
{{ abstract }}class Controller extends BaseController
{
    use AuthorizesRequests;
    use ValidatesRequests;
    // use DispatchesJobs;

    /**
     * @var array<string, string>
     */
    public array $packageInfo = [
        'module_label' => '{{module_label}}',
        'module_label_plural' => '{{module_label_plural}}',
        'module_route' => '{{module_route}}',
        'module_slug' => '{{module_slug}}',
        'privilege' => '{{privilege}}',
    ];

    public function packageInfo(): PackageInfo
    {
        return new PackageInfo()->setOptions($this->packageInfo);
    }
}
